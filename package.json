{
  "name": "browser-harness-ts",
  "version": "0.1.0",
  "description": "Python browser-harness 守护进程的薄 TypeScript 客户端,让 Python 和 TS agent 共享同一个 Chrome。",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "bhts": "./bin/bhts.ts"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "setup:attach": "browser-harness --setup",
    "doctor": "browser-harness --doctor",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "example": "tsx examples/basic.ts",
    "cli": "tsx bin/bhts.ts"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "devtools-protocol": "^0.0.1621552",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "browser",
    "cdp",
    "chrome",
    "automation",
    "agent",
    "browser-harness"
  ],
  "license": "MIT"
}
